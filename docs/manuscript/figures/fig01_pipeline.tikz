\begin{tikzpicture}[
  font=\footnotesize,
  >=Latex,
  stage/.style={draw=black!55, rounded corners=3pt, fill=gray!6, minimum height=0.84cm, align=center, inner sep=5pt},
  object/.style={draw=black!55, rounded corners=3pt, fill=white, minimum height=0.72cm, align=center, inner sep=4pt},
  signal/.style={draw=black!45, rounded corners=2pt, fill=blue!6, minimum height=0.68cm, align=center, inner sep=4pt},
  loss/.style={draw=black!50, rounded corners=2pt, fill=orange!10, minimum height=0.68cm, align=center, inner sep=4pt},
  arrow/.style={->, line width=0.55pt, draw=black!70},
  compare/.style={->, line width=0.5pt, draw=blue!55!black},
]
  % Intervention
  \node[signal, text width=1.55cm] (traintext) at (-6.25,1.25) {training\\text};
  \node[stage, text width=1.65cm] (student) at (-4.15,1.25) {\textbf{student}};
  \node[object, text width=1.75cm] (tokenpred) at (-1.75,2.15) {student token\\prediction};
  \node[object, text width=1.75cm] (activation) at (-1.75,0.35) {selected student\\activation};
  \node[signal, text width=1.75cm] (teacher) at (0.55,3.55) {teacher token\\distribution};
  \node[loss, text width=1.60cm] (kdloss) at (0.55,2.15) {KD loss\\$\mathcal{L}_{\mathrm{KD}}$};
  \node[object, text width=1.75cm] (auxhead) at (0.55,0.35) {auxiliary\\neural head};
  \node[signal, text width=1.90cm] (target) at (3.05,-0.95) {recorded or predicted\\neural target};
  \node[loss, text width=1.65cm] (neurloss) at (3.05,0.35) {auxiliary loss\\$\mathcal{L}_{B}$};
  \node[stage, text width=1.95cm] (update) at (5.35,1.25) {\textbf{joint update}\\permitted student\\parameters and head};
  \node[object, text width=1.75cm] (retain) at (7.65,1.25) {retain student\\discard auxiliary head};

  \draw[arrow] (traintext) -- (student);
  \draw[compare, dashed] (traintext.north) |- (teacher.west);
  \draw[compare, dashed] (traintext.south) |- (target.west);
  \draw[arrow] (student.east) to[out=12,in=180] (tokenpred.west);
  \draw[arrow] (student.east) to[out=-12,in=180] (activation.west);
  \draw[arrow] (tokenpred) -- (kdloss);
  \draw[compare] (teacher) -- (kdloss);
  \draw[arrow] (activation) -- (auxhead);
  \draw[arrow] (auxhead) -- (neurloss);
  \draw[compare] (target) -- (neurloss);
  \draw[arrow] (kdloss.east) to[out=0,in=145] (update.west);
  \draw[arrow] (neurloss.east) to[out=0,in=215] (update.west);
  \draw[arrow] (update) -- (retain);

  % Evaluation
  \node[signal, text width=1.70cm] (heldout) at (-5.80,-3.25) {held-out\\text};
  \node[stage, text width=1.90cm] (frozen) at (-3.35,-3.25) {\textbf{frozen retained}\\\textbf{student}};
  \node[object, text width=1.75cm] (features) at (-0.85,-3.25) {selected-layer\\activations};
  \node[stage, text width=2.15cm] (ridge) at (2.10,-3.25) {\textbf{fresh ridge map}\\fit against recorded\\responses};
  \node[signal, text width=2.00cm] (score) at (5.25,-3.25) {held-out\\unique $R^2$};

  \draw[arrow] (heldout) -- (frozen);
  \draw[arrow] (frozen) -- (features);
  \draw[arrow] (features) -- (ridge);
  \draw[arrow] (ridge) -- (score);

  \node[font=\footnotesize\bfseries, anchor=west] at (-6.95,4.65) {Intervention};
  \draw[black!35, line width=0.45pt] (-6.95,4.45) -- (8.65,4.45);
  \node[font=\footnotesize\bfseries, anchor=west] at (-6.95,-1.85) {Evaluation with retained student weights};
  \draw[black!35, line width=0.45pt] (-6.95,-2.05) -- (8.65,-2.05);
\end{tikzpicture}
