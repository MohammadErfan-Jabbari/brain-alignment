% E006 recorded values used for bar heights:
% untrained unique R^2 = -0.017 for both models; gaps are +0.0207 (GPT-2) and +0.0277 (Qwen2.5-0.5B),
% giving trained means of +0.0037 and +0.0107. See docs/manuscript/extended/numbers.tex and E006.
\begin{tikzpicture}[
  font=\small,
  >=Latex,
  bar/.style={draw=black!45, line width=0.35pt},
  trained/.style={bar, fill=blue!65!black},
  untrained/.style={bar, fill=gray!55},
  tick/.style={font=\footnotesize, text=black!70},
  val/.style={font=\scriptsize, text=black!80, align=center},
  ann/.style={font=\footnotesize, align=center},
]
  \def\ymin{-2.2}
  \def\ymax{1.8}
  \def\bw{0.30}

  % Axes and ticks. Coordinates are value * 100, so 0.010 is y=1.0.
  \draw[->, draw=black!65] (-0.95,\ymin) -- (-0.95,\ymax) node[above, tick] {unique $R^2$};
  \draw[draw=black!45] (-0.95,0) -- (4.65,0);
  \foreach \v/\lab in {-2.0/$-0.020$,-1.5/$-0.015$,-1.0/$-0.010$,-0.5/$-0.005$,0/$0$,0.5/$0.005$,1.0/$0.010$,1.5/$0.015$} {
    \draw[draw=black!45] (-1.02,\v) -- (-0.88,\v);
    \node[tick, anchor=east] at (-1.07,\v) {\lab};
  }

  % GPT-2 group.
  \draw[trained] (0-\bw,0) rectangle (0+\bw,0.37);
  \draw[untrained] (0.72-\bw,0) rectangle (0.72+\bw,-1.70);
  \draw[<->, draw=red!70!black, line width=0.55pt] (1.15,-1.70) -- (1.15,0.37);
  \node[ann, text=red!70!black, anchor=west] at (1.21,-0.66) {gap\\$+0.0207$};
  \node[tick] at (0.36,-2.40) {GPT-2 L7};
  % Absolute bar values.
  \node[val, anchor=south] at (0,0.42) {$+0.0037$};
  \node[val, anchor=north] at (0.72,-1.75) {$-0.017$};

  % Qwen group.
  \draw[trained] (2.75-\bw,0) rectangle (2.75+\bw,1.07);
  \draw[untrained] (3.47-\bw,0) rectangle (3.47+\bw,-1.70);
  \draw[<->, draw=red!70!black, line width=0.55pt] (3.95,-1.70) -- (3.95,1.07);
  \node[ann, text=red!70!black, anchor=west] at (4.01,-0.35) {gap\\$+0.0277$};
  \node[tick] at (3.11,-2.40) {Qwen2.5-0.5B L12};
  % Absolute bar values.
  \node[val, anchor=south] at (2.75,1.12) {$+0.0107$};
  \node[val, anchor=north] at (3.47,-1.75) {$-0.017$};

  % Legend (top right, vertical, clear of value labels).
  \begin{scope}[shift={(3.35,1.65)}]
    \draw[trained] (0,0) rectangle (0.30,0.20);
    \node[tick, anchor=west] at (0.37,0.10) {trained};
    \draw[untrained] (0,-0.32) rectangle (0.30,-0.12);
    \node[tick, anchor=west] at (0.37,-0.22) {untrained};
  \end{scope}
\end{tikzpicture}
