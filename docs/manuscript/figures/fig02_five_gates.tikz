\begin{tikzpicture}[
  font=\small,
  >=Latex,
  node distance=3.5mm,
  gate/.style={font=\footnotesize, draw=black!55, rounded corners=3pt, fill=gray!7, minimum height=2.75cm, text width=2.5cm, align=center, inner xsep=4pt, inner ysep=5pt, execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  last/.style={gate, draw=orange!75!black, fill=orange!13, line width=0.8pt},
  arrow/.style={-{Latex[length=2mm]}, line width=0.65pt, draw=black!60},
]
  \node[gate] (g1) {\textbf{1. Controlled measurement}\\[3pt]{\scriptsize\color{black!78}Do held-out\\responses remain\\predictable beyond\\nuisance and\\untrained-network\\features?}};
  \node[gate, right=of g1] (g2) {\textbf{2. Preservation and quality}\\[3pt]{\scriptsize\color{black!78}Does ordinary\\distillation leave\\room for alignment\\improvement at\\comparable quality?}};
  \node[gate, right=of g2] (g3) {\textbf{3. Identified intervention}\\[3pt]{\scriptsize\color{black!78}Does target fit improve,\\does the student change,\\and are quality and\\the comparator\\adequate?}};
  \node[gate, right=of g3] (g4) {\textbf{4. Biological transfer}\\[3pt]{\scriptsize\color{black!78}Does held-out\\alignment improve\\when participants are\\the inference units?}};
  \node[last, right=of g4] (g5) {\textbf{5. External utility}\\[3pt]{\scriptsize\color{black!78}Does the change\\improve a task or\\transfer to an\\external setting?}};
  \draw[arrow] (g1) -- (g2);
  \draw[arrow] (g2) -- (g3);
  \draw[arrow] (g3) -- (g4);
  \draw[arrow] (g4) -- (g5);
\end{tikzpicture}
