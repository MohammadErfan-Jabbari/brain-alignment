\begin{tikzpicture}[
  font=\small,
  >=Latex,
  node distance=3.5mm,
  gate/.style={font=\footnotesize, draw=black!55, rounded corners=3pt, fill=gray!7, minimum height=2.75cm, text width=2.5cm, align=center, inner xsep=4pt, inner ysep=5pt, execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  last/.style={gate, draw=orange!75!black, fill=orange!13, line width=0.8pt},
  arrow/.style={-{Latex[length=2mm]}, line width=0.65pt, draw=black!60},
]
  \node[gate] (g1) {\textbf{1. Measurable}\\[3pt]{\scriptsize\color{black!78}Does the score\\detect a controlled\\signal beyond\\nuisance and\\untrained features?}};
  \node[gate, right=of g1] (g2) {\textbf{2. Preserved}\\[3pt]{\scriptsize\color{black!78}Does ordinary\\distillation leave\\recoverable\\alignment\\headroom?}};
  \node[gate, right=of g2] (g3) {\textbf{3. Movable}\\[3pt]{\scriptsize\color{black!78}Does the real\\target change\\held-out alignment\\beyond\\controls?}};
  \node[gate, right=of g3] (g4) {\textbf{4. General}\\[3pt]{\scriptsize\color{black!78}Across which\\participants and\\stimuli does the\\effect\\generalize?}};
  \node[last, right=of g4] (g5) {\textbf{5. Useful}\\[3pt]{\scriptsize\color{black!78}Does the change\\transfer beyond\\its training proxy\\to downstream\\behavior?}};
  \draw[arrow] (g1) -- (g2);
  \draw[arrow] (g2) -- (g3);
  \draw[arrow] (g3) -- (g4);
  \draw[arrow] (g4) -- (g5);
\end{tikzpicture}
