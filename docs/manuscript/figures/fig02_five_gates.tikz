\begin{tikzpicture}[
  font=\small,
  >=Latex,
  gate/.style={draw=black!55, rounded corners=3pt, fill=gray!7, minimum width=3.15cm, minimum height=1.25cm, text width=2.85cm, align=center, inner sep=5pt},
  last/.style={gate, draw=orange!75!black, fill=orange!13, line width=0.8pt},
  arrow/.style={-{Latex[length=2.2mm]}, thick, draw=black!55},
  q/.style={font=\footnotesize, text=black!70, align=center, text width=2.8cm},
]
  \node[gate] (g1) at (0,0) {\textbf{1. Measurable}\\beyond nuisance and untrained features};
  \node[gate] (g2) at (3.75,0) {\textbf{2. Preserved}\\under ordinary distillation};
  \node[gate] (g3) at (7.5,0) {\textbf{3. Movable}\\by the real target beyond controls};
  \node[gate] (g4) at (11.25,0) {\textbf{4. General}\\across participants and stimuli};
  \node[last] (g5) at (15,0) {\textbf{5. Useful}\\for transfer or downstream behavior};
  \draw[arrow] (g1) -- (g2);
  \draw[arrow] (g2) -- (g3);
  \draw[arrow] (g3) -- (g4);
  \draw[arrow] (g4) -- (g5);
  \node[q] at (0,-1.15) {Does the score detect a controlled signal?};
  \node[q] at (3.75,-1.15) {Does compression leave recoverable headroom?};
  \node[q] at (7.5,-1.15) {Does the intervention change held-out alignment?};
  \node[q] at (11.25,-1.15) {What population does the effect describe?};
  \node[q] at (15,-1.15) {Does the change matter outside its training proxy?};
\end{tikzpicture}
